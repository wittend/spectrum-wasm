{
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "build:js": "deno run -A scripts/build.ts --skip-cargo",
    "dev": "deno task build && deno run -A --watch=src/,public/ main.ts",
    "start": "deno run -A main.ts",
    "test": "deno task build && deno test -A",
    "test:only": "deno test -A",
    "check": "deno fmt --check && deno lint && deno check main.ts scripts/ tests/ benches/",
    "bench": "deno task build && deno bench -A benches/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/path": "jsr:@std/path@1"
  },
  "exclude": [
    "dist/",
    "wasm/target/",
    ".contrib/"
  ],
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": [
      "public/colormaps.js"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "eqeqeq",
        "no-console",
        "no-eval",
        "no-throw-literal",
        "camelcase",
        "explicit-module-boundary-types",
        "no-non-null-assertion"
      ],
      "exclude": [
        "no-var"
      ]
    },
    "exclude": [
      "public/colormaps.js"
    ]
  },
  "test": {
    "include": [
      "tests/"
    ]
  }
}
