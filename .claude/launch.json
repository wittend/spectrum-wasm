{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spectrum-wasm",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "-A",
        "main.ts"
      ],
      "port": 8000
    },
    {
      "name": "spectrum-wasm-other-host",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "-A",
        "main.ts"
      ],
      "env": {
        "PORT": "8001"
      },
      "port": 8001,
      "url": "http://127.0.0.1:8001"
    }
  ]
}
